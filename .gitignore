# QRDic/ holds the legacy QRSpeed Android project as read-only
# reference (dicpro.txt and the .properties tree) — useful for
# investigating migration questions but never shipped. Live bot
# assets moved to bot/assets/ in 2026-05; keep the reference tree
# untracked so it doesn't bloat history or drift.
QRDic/

# Local tooling runtime state — regenerated on each launch, never commit.
# .codegraph/ keeps its tracked dir/config but daemon.pid changes every run.
.codegraph/daemon.pid
