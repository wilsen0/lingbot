# ---- Logging -------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- OneBot --------------------------------------------------------
# 协议端地址：linling 作为 OneBot v11 客户端主动去连。
# 当前默认接 LLBot(LLOneBot) 的 :3003（见 docker/llbot/docker-compose.yml）。
ONEBOT_WS_URL=ws://127.0.0.1:3003
ONEBOT_TOKEN=
ONEBOT_QQ=
LLBOT_CONFIG_DIR=~/.llbot/llbot_config

# ---- Bot Permissions -----------------------------------------------
# 管理员 QQ 号（对应 bot.yaml 的 admin_users）
BOT_ADMIN_QQ=
# LLM 群聊白名单在 bot.yaml 的 agent.allowed_scopes 里配置
# DSL 规则作用域：只有这些群执行规则，其它群跳过 DSL 但仍可 LLM 对话（逗号分隔）。
# 留空 = 使用 bot.yaml 里的默认值
DSL_SCOPE_IDS=


# ---- LLM (主模型；OpenAI 兼容 / Anthropic Messages) ----------------
# 这些环境变量是 agents/*.yaml 里 ${LLM_API_KEY} / ${LLM_BASE_URL}
# 等占位符的来源。CLI 启动时会自动 load 这个文件到 os.environ,所以
# 填好直接 linling run 即可；Shell / 容器里已经 export 的同名变量优先。
#
# 首选变量是 LLM_*；OPENAI_* 仅作为旧部署的兼容 fallback。
# 当前线上接 DeepSeek 的 OpenAI 兼容端点(与 pi 同一份 key):
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# 其他 OpenAI 兼容端点示例:
#   OpenAI 官方: https://api.openai.com/v1
#   Kimi:        https://api.kimi.com/coding/v1
#   自部署 vLLM: 换成对应 BASE_URL

# 旧变量名（可留空；LLM_* 未设置时才会回退到这里）:
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 想覆盖 agents/*.yaml 里的模型名。当前线上用 DeepSeek:
LINLING_MODEL=deepseek-flash

# 视觉(多模态)模式:true 时机器人能"看见"图片/表情包,并可用
# save_sticker / list_stickers / send_sticker 收藏、查看、发送表情包。
# 需要把 LINLING_MODEL 换成视觉模型(如 gpt-4o / qwen-vl-max 等 OpenAI 兼容的
# 视觉模型),纯文本模型开启会收到不支持多模态的报错。
# 也可以在 agents/*.yaml 里显式写 vision_enabled: true 覆盖(优先级更高),
# 或写 vision_enabled: ${LINLING_VISION_ENABLED:-false} 引用这个变量。
# 当前线上 true（deepseek-flash 支持视觉）；换纯文本模型时改回 false。
LINLING_VISION_ENABLED=true

# ---- LLM Proxy (optional) ----------------------------------------
# OpenAI 协议主 LLM 的 HTTPS 代理（也是 Anthropic 代理的 fallback）。
# 留空则直连。大多数国内可直连的端点 (Kimi/DeepSeek) 不需要；
# 如果主 LLM 用 OpenAI 官方且需翻墙,填这里。
# 格式: http://host:port  /  socks5://host:port
OPENAI_HTTPS_PROXY=

# ---- Group-batch Attention Probe (optional) ----------------------
# 群批 window_s 到点但规则未触发关注时,跑一个轻量 LLM (yes/no) 决定
# 是否把这批消息交给主 LLM。关掉就回到老行为(直接丢弃),也可以把
# bot.yaml 里的 group_batch_attention_probe_enabled 设为 false。
#
# Fallback chain:
#   API key:  ATTENTION_PROBE_API_KEY  -> LLM_API_KEY -> OPENAI_API_KEY
#   Base URL: ATTENTION_PROBE_BASE_URL -> LLM_BASE_URL -> OPENAI_BASE_URL -> https://api.openai.com/v1
#   Model:    ATTENTION_PROBE_MODEL    -> 默认 agent 的 model
#   Proxy:    ATTENTION_PROBE_HTTPS_PROXY -> OPENAI_HTTPS_PROXY -> (direct)
#
# Cost cap: max_tokens=32, temperature=0.0, timeout=8.0s per call。
# 没有 ATTENTION_PROBE_API_KEY / LLM_API_KEY / OPENAI_API_KEY 时,probe 自动跳过
# (启动时会打一条 info 日志)。
ATTENTION_PROBE_API_KEY=
ATTENTION_PROBE_BASE_URL=
ATTENTION_PROBE_MODEL=
# 注意层 LLM 的 HTTPS 代理 (socks5://host:port 或 http://host:port)。
# 留空则直连。独立于主 LLM,方便只给需要翻墙的轻量模型走代理。
ATTENTION_PROBE_HTTPS_PROXY=

# ---- Anthropic Messages 协议 (当前线上 provider: anthropic) --------
# 在 agents/*.yaml 里设 provider: anthropic 后生效。
# 当前 `bot/agents/susu.yaml` 已使用该协议；api_key 留空时回退到
# LLM_API_KEY，所以通常只需要配下面的 BASE_URL。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# 官方 Claude 端点（换官方时把上面改成 https://api.anthropic.com）:
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# 主 LLM 走代理时填这里；留空则回退 OPENAI_HTTPS_PROXY，再留空则直连。
ANTHROPIC_HTTPS_PROXY=

# Gemini 等其他 provider 暂未在 linling_agent 里实现,
# 想接的话另起 provider kind 即可,占位先留着。
GEMINI_PROXY_API_KEY=
GEMINI_PROXY_BASE_URL=

# ---- Storage -------------------------------------------------------
# 数据目录（喂给 bot.yaml 的 storage.data_dir，相对 bot.yaml 所在目录解析）。
# kv / audit / scheduler / files / stickers 全部在该目录下自动推导。
LINLING_DATA_DIR=./data
