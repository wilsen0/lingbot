# ---- Logging -------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- OneBot --------------------------------------------------------
# 协议端地址：linling 作为 OneBot v11 客户端主动去连。
# 当前默认接 LLBot(LLOneBot) 的 :3003（见 docker/llbot/docker-compose.yml）。
ONEBOT_WS_URL=ws://127.0.0.1:3003
ONEBOT_TOKEN=
ONEBOT_QQ=
LLBOT_CONFIG_DIR=~/.llbot/llbot_config

# ---- Bot Permissions & Allowed Groups -----------------------------
# 管理员 QQ 号（对应 bot.yaml 的 admin_users）
BOT_ADMIN_QQ=
# 允许 LLM 闲聊兜底的群号（白名单），留空则按 bot.yaml 缺省
BOT_ALLOWED_SCOPE_1=
BOT_ALLOWED_SCOPE_2=


# ---- LLM (OpenAI 兼容协议,任何 provider 都通过这两项切换) ----------
# 这些环境变量是 agents/*.yaml 里 ${OPENAI_API_KEY} 等占位符的来源。
# CLI 启动时会自动 load 这个文件到 os.environ,所以填好直接 linling run 即可。
# Shell / 容器里已经 export 的同名变量会优先生效,这里是 fallback。

# OpenAI 官方:
#   OPENAI_BASE_URL=https://api.openai.com/v1
# Kimi for Coding (OpenAI 兼容):
#   OPENAI_BASE_URL=https://api.kimi.com/coding/v1
# Azure / vLLM / 自部署:换成对应的 BASE_URL。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 想覆盖默认模型(否则用 agents/*.yaml 里写的或 gpt-4o-mini):
LINLING_MODEL=

# 视觉(多模态)模式:true 时机器人能"看见"图片/表情包,并可用
# save_sticker / list_stickers / send_sticker 收藏、查看、发送表情包。
# 需要把 LINLING_MODEL 换成视觉模型(如 gpt-4o / qwen-vl-max 等 OpenAI 兼容的
# 视觉模型),纯文本模型开启会收到不支持多模态的报错。
# 也可以在 agents/*.yaml 里显式写 vision_enabled: true 覆盖(优先级更高),
# 或写 vision_enabled: ${LINLING_VISION_ENABLED:-false} 引用这个变量。
# 默认 false = 老行为:纯图片/表情消息忽略,不产生任何视觉请求。
LINLING_VISION_ENABLED=false

# ---- LLM Proxy (optional) ----------------------------------------
# 主 LLM 的 HTTPS 代理。留空则直连。大多数国内可直连的端点 (Kimi/DeepSeek)
# 不需要;如果主 LLM 用 OpenAI 官方且需翻墙,填这里。
# 格式: http://host:port  /  socks5://host:port
OPENAI_HTTPS_PROXY=

# ---- Group-batch Attention Probe (optional) ----------------------
# 群批 window_s 到点但规则未触发关注时,跑一个轻量 LLM (yes/no) 决定
# 是否把这批消息交给主 LLM。关掉就回到老行为(直接丢弃),也可以把
# bot.yaml 里的 group_batch_attention_probe_enabled 设为 false。
#
# Fallback chain:
#   API key:  ATTENTION_PROBE_API_KEY  -> OPENAI_API_KEY
#   Base URL: ATTENTION_PROBE_BASE_URL -> OPENAI_BASE_URL -> https://api.openai.com/v1
#   Model:    ATTENTION_PROBE_MODEL    -> 默认 agent 的 model
#   Proxy:    ATTENTION_PROBE_HTTPS_PROXY -> OPENAI_HTTPS_PROXY -> (direct)
#
# Cost cap: max_tokens=32, temperature=0.0, timeout=8.0s per call。
# 没有 ATTENTION_PROBE_API_KEY 也没有 OPENAI_API_KEY 时,probe 自动跳过
# (启动时会打一条 info 日志)。
ATTENTION_PROBE_API_KEY=
ATTENTION_PROBE_BASE_URL=
ATTENTION_PROBE_MODEL=
# 注意层 LLM 的 HTTPS 代理 (socks5://host:port 或 http://host:port)。
# 留空则直连。独立于主 LLM,方便只给需要翻墙的轻量模型走代理。
ATTENTION_PROBE_HTTPS_PROXY=

# Anthropic / Gemini 等其他 provider 暂未在 linling_agent 里实现,
# 想接的话另起 provider kind 即可,占位先留着。
ANTHROPIC_API_KEY=

GEMINI_PROXY_API_KEY=
GEMINI_PROXY_BASE_URL=

# ---- Storage -------------------------------------------------------
LINLING_DATA_DIR=./data
LINLING_KV_URL=sqlite:///./data/kv.db
LINLING_SCHED_URL=sqlite:///./data/sched.db
